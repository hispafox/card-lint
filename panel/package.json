{
  "name": "card-lint-panel",
  "private": true,
  "version": "0.1.0",
  "description": "Cuadro de mando de card-lint: lee los JSON de --historial y genera card-lint.json. Se compila a un solo HTML que se abre sin servidor.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.2"
  }
}
